<Page x:Class="programm.Views.Pages.TechnicPages"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:programm.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1840"
      Title="TechnicPages" Background="#776C76">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <ListView Name="ProductsLv" Grid.Row="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="изображение">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Photo, FallbackValue=C:/Users/vboxuser/Desktop/prog/10/CRUD_operations/CRUD_operations/Image/photo.webp}" Width="100" Height="100"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Название" DisplayMemberBinding="{Binding name}"/>
                    <GridViewColumn Header="Цена" DisplayMemberBinding="{Binding price, StringFormat={}{0:C0}, ConverterCulture=ru-RU}"/>

                    <GridViewColumn Header="Описание" DisplayMemberBinding="{Binding Description}"/>
                    <GridViewColumn Header="Категория" DisplayMemberBinding="{Binding  CategoryId.Name}"/>
                    <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding RealiseDate, StringFormat=dd.MM.yyyy  }"/>
                    <GridViewColumn Header="Доступность На складе" DisplayMemberBinding="{Binding IsAvailableText}"/>

                </GridView>
            </ListView.View>
        </ListView>
        <Button Grid.Row="0" Name="BackBtn" Click="BackBtn_Click" Height="50" Width="100" Content="X" FontSize="40" Background="Transparent" HorizontalAlignment="Right"/>
    </Grid>
</Page>
