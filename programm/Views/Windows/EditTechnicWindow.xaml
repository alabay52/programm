<Window x:Class="programm.Views.Windows.EditTechnicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:programm.Views.Windows"
        mc:Ignorable="d"
                Title="Редактирование данных" Height="500" Width="500" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#776C76">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="10" />
            <RowDefinition Height="50"/>
            <RowDefinition Height="10" />
            <RowDefinition Height="50"/>
            <RowDefinition Height="10" />
            <RowDefinition Height="50"/>
            <RowDefinition Height="10" />
            <RowDefinition Height="50"/>
            <RowDefinition Height="10" />
            <RowDefinition Height="50"/>
            <RowDefinition Height="10" />
            <RowDefinition Height="60"/>
            <RowDefinition Height="10" />


        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Название"/>
        <TextBox x:Name="NameTb"  Grid.Row="0" Grid.Column="2" Text="{Binding Name}"/>
        
        <TextBlock Grid.Row="2" Grid.Column="0" Text="ВИН номер"/>
        <TextBox x:Name="VINTb"  Grid.Row="2" Grid.Column="2" Text="{Binding VIN}"/>
        
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Описание"/>
        <TextBox x:Name="DescriptionTb"  Grid.Row="4" Grid.Column="2" Text="{Binding Description}"/>
        
        <TextBlock Grid.Row="6" Grid.Column="0" Text="Статус"/>
        <ComboBox Name="StatusCmb" Grid.Column="2" Grid.Row="6" SelectedItem="{Binding Status}"/>


        <TextBlock Grid.Row="8" Grid.Column="0" Text="Фото"/>
        <TextBox Name="PhotoTb" Grid.Row="8" Grid.Column="2" Text="{Binding Photo}"/>
        <Button Name="EditBtn" Content="Редактировать данные" Grid.Row="10" Grid.Column="2" Click="EditBtn_Click" Style="{StaticResource CapsuleButton}" FontSize="20"/>
        <Button Name="PhotoBtn" Content="Добавить фото" Grid.Row="12" Grid.Column="2" Click="PhotoBtn_Click" Style="{StaticResource CapsuleButton}" FontSize="20"/>

    </Grid>
</Window>
