<Window x:Class="programm.Views.Windows.EditUsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:programm.Views.Windows"
        mc:Ignorable="d"
                       Title="Редактирование данных" Height="450" Width="500" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#776C76">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="10" />
            <RowDefinition Height="50"/>
            <RowDefinition Height="10" />
            <RowDefinition Height="50"/>
            <RowDefinition Height="10" />
            <RowDefinition Height="50"/>
            <RowDefinition Height="10" />
            <RowDefinition Height="50"/>
            <RowDefinition Height="10" />
            <RowDefinition Height="50"/>
            <RowDefinition Height="10" />
            <RowDefinition Height="50"/>
            <RowDefinition Height="10" />


        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="ФИО:"/>
        <TextBox x:Name="NameTb"  Grid.Row="0" Grid.Column="2" Text="{Binding FullName}"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Почта:"/>
        <TextBox x:Name="EmailTb"  Grid.Row="2" Grid.Column="2" Text="{Binding Email}"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Телефон:"/>
        <TextBox x:Name="TelephoneTb"  Grid.Row="4" Grid.Column="2" Text="{Binding Telephone}"/>
        <TextBlock Grid.Row="6" Grid.Column="0" Text="Паспорт:"/>
        <TextBox Name="PassportTb" Grid.Column="2" Grid.Row="6" Text="{Binding PassportData}"/>



        <Button Name="EditBtn" Content="Редактировать данные" Grid.Row="10" Grid.Column="2" Click="EditBtn_Click"  Style="{StaticResource CapsuleButton}" FontSize="20"/>
        

    </Grid>
</Window>
