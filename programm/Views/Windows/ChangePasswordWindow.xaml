<Window x:Class="programm.Windows.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:programm.Windows"
        mc:Ignorable="d"
        Title="Окно смены пароля" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#776C76">
    <Grid Margin="20" >
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="20" />
            <RowDefinition Height="50" />
            <RowDefinition Height="20" />
            <RowDefinition Height="50" />
            <RowDefinition Height="20" />
            <RowDefinition Height="50" />
            <RowDefinition Height="20" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Ваш логин:" />
        <TextBox  Name="LoginTb" Grid.Column="2" />
        <TextBlock Text="Старый пароль:" Grid.Row="2"/>
        <PasswordBox  Name="OldPasswordPb" Grid.Column="2" Grid.Row="2"/>
        <TextBlock Text="Новый пароль:" Grid.Row="4"/>
        <PasswordBox  Name="NewPasswordPb" Grid.Column="2" Grid.Row="4"/>
        <TextBlock Text="Подтверждение пароля:" Grid.Row="6"/>
        <PasswordBox Name="ChangeNewPasswordPb" Grid.Column="2" Grid.Row="6"/>

        <Button Name="ChangePasswordBtn" Grid.Row="8" Grid.Column="2" Content="Изменить пароль"  Click="ChangePasswordBtn_Click" Style="{StaticResource CapsuleButton}"/>
    </Grid>
</Window>
