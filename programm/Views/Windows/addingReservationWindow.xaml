<Window x:Class="programm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:programm"
        mc:Ignorable="d"
        Title="MainWindow" Height="1080" Width="1920" WindowStyle="None" WindowState="Maximized" WindowStartupLocation="CenterScreen">
    <Grid Background="#3D4347">
        <Grid.RowDefinitions>
            <RowDefinition Height="200" />
            <RowDefinition Height="880" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="385" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="450" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="30" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="8" FontSize="30" TextWrapping="Wrap" Foreground="White" Grid.RowSpan="3" Text="Данный раздел предназначен для работы бронью"/>


           

            <TextBlock Grid.Column="2" FontSize="30" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" Grid.RowSpan="3" Text="Прокат квадроциклов в Москве и области"/>
            <Image Source="/image/LOGO2.png" Grid.RowSpan="3" Height="170" Width="200"/>
            <Button Height="170" Width="200" Grid.RowSpan="3"  Grid.Column="10" Background="Transparent" Name="ProfileBtn" Click="ProfileBtn_Click"  BorderThickness="0">
                <Image Source="/image/PROFILE2.png" Grid.RowSpan="3" Height="170" Width="200" Grid.Column="10"/>
            </Button>

        </Grid>
        
        
        
        
        
        
        <Grid Grid.Row="1">
            <Grid.Background>
                <ImageBrush ImageSource="\image\BACKGROUND.png"></ImageBrush>
            </Grid.Background>
            <Grid Margin="40" Background="#776C76">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="100"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Пользователь -->
                    <TextBlock Grid.Row="0" Grid.Column="0" FontSize="20" Text="Клиент:" Margin="5"/>
                    <ComboBox x:Name="cmbUser" Grid.Row="0" Grid.Column="1"  Margin="5" DisplayMemberPath="FullName" SelectedValuePath="IdUser"/>

                    <!-- Техника -->
                    <TextBlock Grid.Row="1" Grid.Column="0" FontSize="20" Text="Техника:" Margin="5"/>
                    <ComboBox x:Name="cmbTechnic" Grid.Row="1" Grid.Column="1" Margin="5" DisplayMemberPath="Name" SelectedValuePath="IdTechnic"/>

                    <!-- Тариф -->
                    <TextBlock Grid.Row="2" Grid.Column="0" FontSize="20" Text="Тариф:" Margin="5"/>
                    <ComboBox x:Name="cmbTariff" Grid.Row="2" Grid.Column="1" Margin="5" DisplayMemberPath="DisplayName" SelectedValuePath="IdTariff" >
                        <!-- DisplayName можно задать через форматирование, но проще в коде сделать свойство -->
                    </ComboBox>

                    <!-- Дата начала -->
                    <TextBlock Grid.Row="3" Grid.Column="0" FontSize="20" Text="Дата начала:" Margin="5"/>
                    <DatePicker x:Name="dpStartDate" Grid.Row="3" Grid.Column="1" Margin="5" SelectedDate="{Binding StartDate}"/>

                    <!-- Дата окончания -->
                    <TextBlock Grid.Row="4" Grid.Column="0" FontSize="20" Text="Дата окончания:" Margin="5"/>
                    <DatePicker x:Name="dpEndDate" Grid.Row="4" Grid.Column="1" Margin="5" SelectedDate="{Binding EndDate}"/>

                    <!-- Цена -->
                    <TextBlock Grid.Row="5" Grid.Column="0" FontSize="20" Text="Цена:" Margin="5"/>
                    <TextBox x:Name="txtPrice" Grid.Row="5" Grid.Column="1" Margin="5" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Кнопки -->
                    <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                        <Button x:Name="btnSave" Content="Сохранить" Click="btnSave_Click" Width="180" Margin="5"  Style="{StaticResource CapsuleButton}"/>
                        <Button x:Name="btnCancel" Content="Назад" Width="180" Margin="5" Click="btnCancel_Click"  Style="{StaticResource CapsuleButton}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
