<Window x:Class="programm.Views.Windows.AddUsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:programm.Views.Windows"
        mc:Ignorable="d"
               Title="MainWindow" Height="1080" Width="1920" WindowStyle="None" WindowState="Maximized" WindowStartupLocation="CenterScreen">
    <Grid Background="#3D4347">
        <Grid.RowDefinitions>
            <RowDefinition Height="200" />
            <RowDefinition Height="880" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="385" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="450" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="30" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="8" FontSize="30" TextWrapping="Wrap" Foreground="White" Grid.RowSpan="3" Text="Данный раздел предназначен для работы бронью"/>




            <TextBlock Grid.Column="2" FontSize="30" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" Grid.RowSpan="3" Text="Прокат квадроциклов в Москве и области"/>
            <Image Source="/image/LOGO2.png" Grid.RowSpan="3" Height="170" Width="200"/>
            <Button Height="170" Width="200" Grid.RowSpan="3"  Grid.Column="10" Background="Transparent" Name="ProfileBtn" Click="ProfileBtn_Click"  BorderThickness="0">
                <Image Source="/image/PROFILE2.png" Grid.RowSpan="3" Height="170" Width="200" Grid.Column="10"/>
            </Button>

        </Grid>






        <Grid Grid.Row="1">
            <Grid.Background>
                <ImageBrush ImageSource="\image\BACKGROUND.png"></ImageBrush>
            </Grid.Background>
            <Grid Margin="40" Background="#776C76">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="100"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="450"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="450"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="1" FontSize="40" Text="Добавление клиента" Margin="5" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" FontSize="20" Text="ФИО клиента:" Margin="5" HorizontalAlignment="Right"/>
                    <TextBox x:Name="NameClientTb" Grid.Row="1" Grid.Column="1"  Margin="5" />

                
                    <TextBlock Grid.Row="2" Grid.Column="0" FontSize="20" Text="Роль:" Margin="5" HorizontalAlignment="Right"/>
                    <ComboBox x:Name="RoleClientCmb" Grid.Row="2" Grid.Column="1" Margin="5" DisplayMemberPath="Name" SelectedValuePath="IdRole"/>

                    
                    <TextBlock Grid.Row="3" Grid.Column="0" FontSize="20" Text="Почта клиента:" Margin="5" HorizontalAlignment="Right"/>
                    <TextBox x:Name="EmailClientTb" Grid.Row="3" Grid.Column="1"  Margin="5" />

                  

                 
                    <TextBlock Grid.Row="4" Grid.Column="0" HorizontalAlignment="Right" FontSize="20" Text="Телефон клиента:" Margin="5"/>
                    <TextBox x:Name="TelephoneClientTb" Grid.Row="4" Grid.Column="1"  Margin="5" />

                   
                    <TextBlock Grid.Row="5" Grid.Column="0" HorizontalAlignment="Right" FontSize="20" Text="Паспорт:" Margin="5"/>
                    <TextBox x:Name="PassportClientTb" Grid.Row="5" Grid.Column="1"  Margin="5" />


                    <Button x:Name="btnSaveClient" Grid.Column="1" Grid.Row="7" Content="Сохранить клиента" Click="btnSaveClient_Click"  Width="350" Margin="5"  Style="{StaticResource CapsuleButton}"/>
                    
                    <Button x:Name="btnCancel" Content="Назад" Grid.Column="6" Grid.Row="7" Width="180" Margin="5" Click="btnCancel_Click"  HorizontalAlignment="Right"  Style="{StaticResource CapsuleButton}"/>
                    <Button x:Name="DeleteBtn" Content="Удалить клиента" Grid.Column="4" Grid.Row="7" Width="220" Margin="5" Click="DeleteBtn_Click"  HorizontalAlignment="Right"  Style="{StaticResource CapsuleButton}"/>

                    <TextBlock Grid.Column="3"  Grid.Row="1" FontSize="30" HorizontalAlignment="Right" Text="Поиск:"/>
                    <TextBox Name="SearchTb" Grid.Column="4" Grid.Row="1" Width="400" Height="80" TextChanged="SearchTb_TextChanged"/>


                    <Grid Grid.RowSpan="4" Grid.Row="2"  Grid.Column="3"  Grid.ColumnSpan="4">
                        <ListView Name="UsersLv" Grid.Row="1">
                            <ListView.View>
                                <GridView>
                                
                                    <GridViewColumn Header="ФИО клиента" Width="200" DisplayMemberBinding="{Binding FullName}"/>
                                    <GridViewColumn Header="Почта" Width="200" DisplayMemberBinding="{Binding Email}"/>
                                    <GridViewColumn Header="Телефон" Width="200" DisplayMemberBinding="{Binding Telephone}"/>
                                    <GridViewColumn Header="Паспорт" Width="200" DisplayMemberBinding="{Binding PassportData}"/>



                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>




                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
