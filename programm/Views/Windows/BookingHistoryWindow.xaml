<Window x:Class="programm.Windows.BookingHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:programm.Windows"
        mc:Ignorable="d"
        Title="BookingHistoryWindow" Height="1080" Width="1920" WindowStyle="None" WindowState="Maximized" WindowStartupLocation="CenterScreen">
    <Grid Background="#3D4347">
        <Grid.RowDefinitions>
            <RowDefinition Height="200" />
            <RowDefinition Height="880" />
            
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="385" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="450" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="30" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="8" 
                       FontSize="30" TextWrapping="Wrap" Grid.RowSpan="3" Text="Данный раздел предназначен для работы бронью" Foreground="White"/>


           

            <TextBlock Grid.Column="2" FontSize="30" TextWrapping="Wrap" VerticalAlignment="Center" Grid.RowSpan="3" Text="Прокат квадроциклов в Москве и области" Foreground="White"/>
            <Image Source="/image/LOGO2.png" Grid.RowSpan="3" Height="170" Width="200"/>
            <Button Height="170" Width="200" Grid.RowSpan="3"  Grid.Column="10" Background="Transparent" Name="ProfileBtn" Click="ProfileBtn_Click"  BorderThickness="0">
                <Image Source="/image/PROFILE2.png" Grid.RowSpan="3" Height="170" Width="200" Grid.Column="10"/>
            </Button>

        </Grid>






        <Grid Grid.Row="1">
            <Grid.Background>
                <ImageBrush ImageSource="\image\BACKGROUND.png"></ImageBrush>
            </Grid.Background>
            <Grid Margin="40" Background="#776C76">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="100" />
                    </Grid.RowDefinitions>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="30" HorizontalAlignment="Right" Text="Поиск:"/>
                        <TextBox Name="SearchTb" Grid.Column="1" Width="800" TextChanged="SearchTb_TextChanged"/>
                    </Grid>
                    <ListView Name="BookindLv" Grid.Row="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="изображение" Width="250">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding Technic.Photo}" Width="150" Height="150"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Название техники" Width="200"   DisplayMemberBinding="{Binding Technic.Name}"/>
                                <GridViewColumn Header="ФИО клиента" Width="200" DisplayMemberBinding="{Binding Users.FullName}"/>
                                <GridViewColumn Header="Тариф" Width="200" DisplayMemberBinding="{Binding TariffRents.Name}"/>
                                <GridViewColumn Header="Дата начала" Width="200" DisplayMemberBinding="{Binding StartDateBooking, StringFormat=dd.MM.yyyy}"/>
                                <GridViewColumn Header="Дата конца" Width="200" DisplayMemberBinding="{Binding EndDateBooking, StringFormat=dd.MM.yyyy}"/>

                                <GridViewColumn Header="Стоимость" Width="200" DisplayMemberBinding="{Binding Price, StringFormat={}{0:C0}, ConverterCulture=ru-RU}"/>
                                <GridViewColumn Header="Кем оформлено" Width="200" DisplayMemberBinding="{Binding Users1.FullName}"/>





                            </GridView>
                        </ListView.View>
                    </ListView>
                    <Grid Grid.Row="2" Margin="5">
                        <Grid.ColumnDefinitions >
                            <ColumnDefinition Width="8*" />
                            <ColumnDefinition Width="2*"  />
                        </Grid.ColumnDefinitions>
                    <Button Grid.Row="2" Grid.Column="1"
                            Name="BackBtn" Click="BackBtn_Click_1" 
                            Height="70" Width="150" Content="Назад" Style="{StaticResource CapsuleButton}"   HorizontalAlignment="Right"/>
                        
                        <Button Grid.Row="2" Grid.Column="1"
        Name="EditBtn" Click="EditBtn_Click" 
        Height="70" Width="auto" Content="Редактировать" Style="{StaticResource CapsuleButton}"   HorizontalAlignment="Left" Margin="9"/>
                        
                    <Button Grid.Row="2" 
        Name="DeleteBtn" Click="DeleteBtn_Click" 
        Height="70" Width="auto" Content="Удалить бронирование" Style="{StaticResource CapsuleButton}"   HorizontalAlignment="Right"/>
                    </Grid>
                    
                </Grid>
                
                
            </Grid>
            </Grid>
    </Grid>
</Window>
