<Window x:Class="programm.Window.BookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:programm.Window"
        mc:Ignorable="d"
                Title="MainWindow" Height="1080" Width="1920" WindowStyle="None" WindowState="Maximized" WindowStartupLocation="CenterScreen">
    <Grid Background="#3D4347">
        <Grid.RowDefinitions>
            <RowDefinition Height="200" />
            <RowDefinition Height="880" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="385" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="450" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="30" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <!--<TextBlock Grid.Column="8" FontSize="30" TextWrapping="Wrap" Grid.RowSpan="3" Text="Данный раздел предназначен для работы бронью" Foreground="White"/>-->




            <TextBlock Grid.Column="2" FontSize="30" TextWrapping="Wrap" VerticalAlignment="Center" Grid.RowSpan="3" Text="Прокат квадроциклов в Москве и области" Foreground="White"/>
            <Image Source="/image/LOGO2.png" Grid.RowSpan="3" Height="170" Width="200"/>
            <Button Height="170" Width="200" Grid.RowSpan="3"  Grid.Column="10" Background="Transparent" Name="ProfileBtn" Click="ProfileBtn_Click"  BorderThickness="0">
                <Image Source="/image/PROFILE2.png" Grid.RowSpan="3" Height="170" Width="200" Grid.Column="10"/>
            </Button>

        </Grid>






        <Grid Grid.Row="1">
            <Grid.Background>
                <ImageBrush ImageSource="\image\BACKGROUND.png"></ImageBrush>
            </Grid.Background>
            <Grid Margin="40" Background="#776C76">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="150" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <!--<Button Name="statusEquipmentBtn" Click="statusEquipmentBtn_Click" Grid.Column="4" Content="Статус техники" Height="100" Width="300" Style="{StaticResource CapsuleButton}"/>-->
                <!--<Button Grid.Column="2"   Height="100" Width="300" Style="{StaticResource CapsuleButton}">
                    <TextBlock Text="Подтверждение онлайн бронирования" TextWrapping="Wrap" TextAlignment="Center"/>
                </Button>-->
                <Button Name="AddReservation" Click="AddReservation_Click" Grid.Column="0"  Height="100" Width="300" Style="{StaticResource CapsuleButton}">
                    <TextBlock Text="Добавление бронирования" TextWrapping="Wrap" TextAlignment="Center"/>
                </Button>
                <Button Name="HistoryBooking" Click="HistoryBooking_Click" Grid.Column="2" Content="История бронирования " Height="100" Width="300" Style="{StaticResource CapsuleButton}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
