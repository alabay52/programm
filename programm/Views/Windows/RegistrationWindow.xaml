<Window x:Class="programm.Views.Windows.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:programm.Views.Windows"
        mc:Ignorable="d"
        Title="Окно регистрации" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="#776C76">
        <Grid.RowDefinitions>

            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="80"/>
            
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="450" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" FontSize="40" Text="Регистрация" Margin="5" HorizontalAlignment="Center"/>
        <TextBlock Grid.Row="1" Grid.Column="0" FontSize="20" Text="ФИО сотрудника:" Margin="5" HorizontalAlignment="Right"/>
        <TextBox x:Name="NameEmployeeTb" Grid.Row="1" Grid.Column="4"  Margin="5" />


        <TextBlock Grid.Row="2" Grid.Column="0" FontSize="20" Text="Должность:" Margin="5" HorizontalAlignment="Right"/>
        <ComboBox x:Name="RoleEmployeeCmb" Grid.Row="2" Grid.Column="4" Margin="5" DisplayMemberPath="Name" SelectedValuePath="IdRole"/>


        <TextBlock Grid.Row="3" Grid.Column="0" FontSize="20" Text="Почта:" Margin="5" HorizontalAlignment="Right"/>
        <TextBox x:Name="EmailEmployeeTb" Grid.Row="3" Grid.Column="4"  Margin="5" />
        <TextBlock Grid.Row="4" Grid.Column="0" FontSize="20" Text="Телефон:" Margin="5" HorizontalAlignment="Right"/>
        <TextBox x:Name="TelephoneTb" Grid.Row="4" Grid.Column="4"  Margin="5" />



        <TextBlock Grid.Row="5" Grid.Column="0" HorizontalAlignment="Right" FontSize="20" Text="Логин:" Margin="5"/>
        <TextBox x:Name="LoginTb" Grid.Row="5" Grid.Column="4"  Margin="5" />


        <TextBlock Grid.Row="6" Grid.Column="0" HorizontalAlignment="Right" FontSize="20" Text="Пароль:" Margin="5"/>
        <PasswordBox x:Name="PaswordPb" Grid.Row="6" Grid.Column="4"  Margin="5" />
        <Button x:Name="btnSaveEmployee" Grid.Column="4" Grid.Row="7" Content="Зарегистрироваться" Click="btnSaveEmployee_Click"  Width="350" Margin="5"  Style="{StaticResource CapsuleButton}"/>
    </Grid>
</Window>
