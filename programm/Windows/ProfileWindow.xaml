<Window x:Class="programm.Windows.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:programm.Windows"
        mc:Ignorable="d"
              Title="BookingHistoryWindow" Height="1080" Width="1920" WindowStyle="None" WindowState="Maximized" WindowStartupLocation="CenterScreen">
    <Grid Background="#3D4347">

        <Grid.RowDefinitions>
            <RowDefinition Height="200" />
            <RowDefinition Height="880" />

        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="385" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="450" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="30" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

           


          

            <TextBlock Grid.Column="2" FontSize="30" TextWrapping="Wrap" VerticalAlignment="Center" Grid.RowSpan="3" Text="Прокат квадроциклов в Москве и области" Foreground="White"/>
            <Image Source="/image/LOGO2.png" Grid.RowSpan="3" Height="170" Width="200"/>
    

        </Grid>
        <Grid Grid.Row="1">
            <Grid.Background>
                <ImageBrush ImageSource="\image\BACKGROUND.png"></ImageBrush>
            </Grid.Background>
            <Grid Margin="40" Background="#776C76">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="6*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <Grid Grid.ColumnSpan="2" Background="#776C76"/>


                <StackPanel Grid.Row="1" Orientation="Vertical" Margin="10">

                    <Button Content="Назад"  Margin="0 50"  Height="80" Style="{StaticResource CapsuleButton}" Name="BackBtnd" Click="BackBtnd_Click" />
                 

                    

                   
                        <Button Name="QuitBtn" Click="QuitBtn_Click" Content="Выйти" Style="{StaticResource CapsuleButton}" Margin="0 470 0 0"    Height="80"  />
                   
                </StackPanel>
                <Grid  Grid.Row="1" Grid.Column="1" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.ColumnSpan="3" Text="Профиль" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="54" FontWeight="Bold"/>

                    <TextBlock Grid.Row="1" Text="Имя: " FontSize="36" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <TextBlock Name="NameTbl" Grid.Row="1" Grid.Column="2" Text="{Binding FullName}" VerticalAlignment="Center" FontSize="36" Foreground="Black" TextWrapping="WrapWithOverflow"/>

                    <TextBlock Grid.Row="2" Text="Должность: " FontSize="36" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <TextBlock Name="RoleTbl" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Text="{Binding IdRole.Name}" FontSize="36" Foreground="Black"/>

                    <TextBlock Grid.Row="3" Text="Эл.Почта: " FontSize="36" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <TextBlock Name="EmailTbl" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Text="{Binding Email}" FontSize="36" Foreground="Black"/>

                    <TextBlock Grid.Row="4" Text="Телефон: " FontSize="36" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <TextBlock Name="PhoneTbl" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" Text="{Binding Telephone}" FontSize="36" Foreground="Black"/>

                    <TextBlock Grid.Row="5" Text="Логин: " FontSize="36" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <TextBlock Name="LoginTbl" Grid.Row="5" Grid.Column="2" VerticalAlignment="Center" Text="{Binding Login}" FontSize="36" Foreground="Black"/>

                   

                </Grid>

          





            <!--<Button Name="BackBtn" Click="BackBtn_Click"  Grid.ColumnSpan="2" Grid.Row="2" Content="Назад" Height="70" Width="300" Style="{StaticResource CapsuleButton}"/>-->

            </Grid>
        </Grid>
 
    </Grid>
</Window>
